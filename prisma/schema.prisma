generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Team {
  id                 Int          @id
  name               String
  abbreviation       String
  city               String
  conference         String
  division           String
  updatedAt          DateTime     @default(now())
  fullName           String
  players            Player[]
  homeGames     Game[] @relation("HomeGames")
  visitorGames  Game[] @relation("VisitorGames")
}

model Player {
  id              Int               @id
  firstName       String
  lastName        String
  position        String?
  height          String?
  weight          String?
  teamId          Int?
  updatedAt       DateTime          @default(now())
  team            Team?             @relation(fields: [teamId], references: [id])
}

model Game {
  id                   Int      @id
  date                 DateTime
  datetime             DateTime?
  season               Int
  status               String?
  time                 String?
  postseason           Boolean
  postponed            Boolean?
  homeTeamScore        Int?
  visitorTeamScore     Int?
  homeQ1               Int?
  homeQ2               Int?
  homeQ3               Int?
  homeQ4               Int?
  homeOt1              Int?
  homeOt2              Int?
  homeOt3              Int?
  homeTimeoutsRemaining Int?
  homeInBonus          Boolean?
  visitorQ1            Int?
  visitorQ2            Int?
  visitorQ3            Int?
  visitorQ4            Int?
  visitorOt1           Int?
  visitorOt2           Int?
  visitorOt3           Int?
  visitorTimeoutsRemaining Int?
  visitorInBonus       Boolean?
  homeTeamId           Int
  visitorTeamId        Int
  homeTeam             Team     @relation("HomeGames", fields: [homeTeamId], references: [id])
  visitorTeam          Team     @relation("VisitorGames", fields: [visitorTeamId], references: [id])
}
